FUNCTION_BLOCK "Semantic_CompareTwoReferences"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_TEMP
    referenceA : REF_TO Int;
    referenceB : REF_TO Int;
    equal      : Bool;
END_VAR

BEGIN
    #equal := #referenceA = #referenceB;
    // EXPECT: error[reference.comparison-only-null] SEM-REF-008
END_FUNCTION_BLOCK
