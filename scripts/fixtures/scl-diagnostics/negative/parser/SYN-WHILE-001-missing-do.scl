FUNCTION_BLOCK "Syntax_WhileMissingDo"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR
    a        : Int := 1;
    b        : Int := 2;
    result   : Int := 0;
    flag     : Bool := TRUE;
    i        : Int := 0;
    values   : Array[0..9] of Int;
END_VAR
BEGIN
    WHILE #i < 10
        #i := #i + 1;
    END_WHILE;
    // EXPECT: error[syntax.while-missing-do] SYN-WHILE-001

END_FUNCTION_BLOCK
