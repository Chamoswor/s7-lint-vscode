FUNCTION_BLOCK "Syntax_ForMissingTo"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR
    a        : Int := 1;
    b        : Int := 2;
    result   : Int := 0;
    flag     : Bool := TRUE;
    i        : Int := 0;
    values   : Array[0..9] of Int;
END_VAR
BEGIN
    FOR #i := 0 9 DO
        #values[#i] := #i;
    END_FOR;
    // EXPECT: error[syntax.for-missing-to] SYN-FOR-002

END_FUNCTION_BLOCK
