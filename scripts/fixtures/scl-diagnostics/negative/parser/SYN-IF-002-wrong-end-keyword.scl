FUNCTION_BLOCK "Syntax_IfWrongEndKeyword"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR
    a        : Int := 1;
    b        : Int := 2;
    result   : Int := 0;
    flag     : Bool := TRUE;
    i        : Int := 0;
    values   : Array[0..9] of Int;
END_VAR
BEGIN
    IF #flag THEN
        #result := 1;
    ENDIF;
    // EXPECT: error[syntax.expected-end-if] SYN-IF-002

END_FUNCTION_BLOCK
