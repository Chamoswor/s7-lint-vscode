FUNCTION_BLOCK "Syntax_ElsifMissingThen"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR
    a        : Int := 1;
    b        : Int := 2;
    result   : Int := 0;
    flag     : Bool := TRUE;
    i        : Int := 0;
    values   : Array[0..9] of Int;
END_VAR
BEGIN
    IF #a = 0 THEN
        #result := 0;
    ELSIF #a = 1
        #result := 1;
    ELSE
        #result := 2;
    END_IF;
    // EXPECT: error[syntax.elsif-missing-then] SYN-IF-004

END_FUNCTION_BLOCK
