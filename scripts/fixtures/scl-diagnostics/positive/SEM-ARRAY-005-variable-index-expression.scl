FUNCTION_BLOCK "Semantic_ArrayVariableIndexExpression"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR
    i      : Int := 0;
    values : Array[0..9] of Int;
END_VAR

BEGIN
    #values[#i + 1] := 10;
    // EXPECT: no diagnostics -- a variable expression IS a legal array index.
END_FUNCTION_BLOCK
