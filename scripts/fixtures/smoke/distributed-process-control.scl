FUNCTION_BLOCK "ProcessSensorAlarms"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2


































   VAR_INPUT
      DeviceTag : String;
      STATUS : Word;
   END_VAR

   VAR
      SensorNetwork_IDMismatch {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_SensorRemoved {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_WrongType {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_HardwareFault {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_InterfaceError {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_Calibrating {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_Maintenance {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      SensorNetwork_UnknownStatus {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
   END_VAR

   VAR_TEMP
      sig_idMismatch : Bool;
      sig_sensorRemoved : Bool;
      sig_wrongType : Bool;
      sig_hwFault : Bool;
      sig_interfaceErr : Bool;
      sig_calibrating : Bool;
      sig_maintenance : Bool;
      sig_unknown : Bool;
   END_VAR

   VAR CONSTANT
      STATUS_OK : Word := 16#0000;
      STATUS_ID_MISMATCH : Word := 16#8A02;
      STATUS_SENSOR_REMOVED : Word := 16#3961;
      STATUS_WRONG_TYPE : Word := 16#3863;
      STATUS_HW_FAULT : Word := 16#3942;
      STATUS_INTERFACE_ERR : Word := 16#6981;
      STATUS_CALIBRATING : Word := 16#7301;
      STATUS_MAINTENANCE : Word := 16#7302;
   END_VAR


BEGIN







	    #sig_idMismatch    := #STATUS = #STATUS_ID_MISMATCH;
	    #sig_sensorRemoved := #STATUS = #STATUS_SENSOR_REMOVED;
	    #sig_wrongType     := #STATUS = #STATUS_WRONG_TYPE;
	    #sig_hwFault       := #STATUS = #STATUS_HW_FAULT;
	    #sig_interfaceErr  := #STATUS = #STATUS_INTERFACE_ERR;
	    #sig_calibrating   := #STATUS = #STATUS_CALIBRATING;
	    #sig_maintenance   := #STATUS = #STATUS_MAINTENANCE;

	    #sig_unknown := (#STATUS <> #STATUS_OK)
	                    AND NOT #sig_idMismatch
	                    AND NOT #sig_sensorRemoved
	                    AND NOT #sig_wrongType
	                    AND NOT #sig_hwFault
	                    AND NOT #sig_interfaceErr
	                    AND NOT #sig_calibrating
	                    AND NOT #sig_maintenance;

	    #SensorNetwork_IDMismatch(SIG := #sig_idMismatch,
	                            SD_1 := #DeviceTag);

	    #SensorNetwork_SensorRemoved(SIG := #sig_sensorRemoved,
	                               SD_1 := #DeviceTag);

	    #SensorNetwork_WrongType(SIG := #sig_wrongType,
	                           SD_1 := #DeviceTag);

	    #SensorNetwork_HardwareFault(SIG := #sig_hwFault,
	                               SD_1 := #DeviceTag);

	    #SensorNetwork_InterfaceError(SIG := #sig_interfaceErr,
	                                SD_1 := #DeviceTag);

	    #SensorNetwork_Calibrating(SIG := #sig_calibrating,
	                             SD_1 := #DeviceTag);

	    #SensorNetwork_Maintenance(SIG := #sig_maintenance,
	                             SD_1 := #DeviceTag);

	    #SensorNetwork_UnknownStatus(SIG := #sig_unknown,
	                               SD_1 := #DeviceTag,
	                               SD_2 := #STATUS);


END_FUNCTION_BLOCK

