FUNCTION_BLOCK "HMI_Alarms"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1




   VAR_INPUT
      "Name" : String;
      Disconnected : Bool;
   END_VAR

   VAR
      HMIConnectionLost {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
   END_VAR


BEGIN

	    #HMIConnectionLost(SIG := #Disconnected,
	                       SD_1 := #Name);


END_FUNCTION_BLOCK

FUNCTION_BLOCK "Drive_Alarms"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3









   VAR_INPUT
      DeviceTag : String;
   END_VAR

   VAR_IN_OUT
      AlarmData : "Drive_AlarmData";
   END_VAR

   VAR
      VFDTrip {InstructionName := 'Program_Alarm'; LibVersion := '1.0'; ExternalWritable := 'False'} : Program_Alarm;
      VFDConnectionLost {InstructionName := 'Program_Alarm'; LibVersion := '1.0'; ExternalWritable := 'False'} : Program_Alarm;
      OverrideActive {InstructionName := 'Program_Alarm'; LibVersion := '1.0'; ExternalWritable := 'False'} : Program_Alarm;
      VFDNotReady {InstructionName := 'Program_Alarm'; LibVersion := '1.0'; ExternalWritable := 'False'} : Program_Alarm;
   END_VAR


BEGIN

	    #VFDTrip(SIG := #AlarmData.VFDtripped,
	             SD_1 := #DeviceTag);

	    #VFDConnectionLost(SIG := #AlarmData.VFDcomLoss,
	                       SD_1 := #DeviceTag);

	    #OverrideActive(SIG := #AlarmData.OverrideActiveTooLong,
	                    SD_1 := #DeviceTag);

	    #VFDNotReady(SIG := #AlarmData.VFDnotReady,
	                 SD_1 := #DeviceTag);
END_FUNCTION_BLOCK

FUNCTION_BLOCK "GasAlarms"
TITLE = 'Gas FlowController Alarm Handler'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.6





































   VAR_INPUT
      DeviceTag : String;
   END_VAR

   VAR_IN_OUT
      Data : "GasProcessData";
   END_VAR

   VAR
      FlowControllerValveNotOpening {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerValveNotClosing {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerSetpointMismatch {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerNamurRed {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerNamurYellow {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerNamurBlue {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerNamurOrange {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      FlowControllerCommFault {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasPressureLow {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasPressureHigh {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasSaturationLow {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasSaturationHigh {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasCalibrationOverdue {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasPumpFeedbackError {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasPumpTrip {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      _ProcessSensorAlarms { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ProcessSensorAlarms";
   END_VAR


BEGIN


	    #FlowControllerValveNotOpening(SIG := #Data.Alarms.FlowControllerAlarms.ValveNotOpening,
	                        SD_1 := #DeviceTag,
	                        SD_2 := #Data.FlowController.actFlow,
	                        SD_3 := #Data.Pressure.ActVal);

	    #FlowControllerValveNotClosing(SIG := #Data.Alarms.FlowControllerAlarms.ValveNotClosing,
	                        SD_1 := #DeviceTag,
	                        SD_2 := #Data.FlowController.actFlow);

	    #FlowControllerSetpointMismatch(SIG := #Data.Alarms.FlowControllerAlarms.SetpointMismatch,
	                         SD_1 := #DeviceTag);











	    #FlowControllerNamurRed(SIG := #Data.Alarms.FlowControllerAlarms.NamurFailure,
	                 SD_1 := #DeviceTag);

	    #FlowControllerNamurYellow(SIG := #Data.Alarms.FlowControllerAlarms.NamurOutOfSpec,
	                    SD_1 := #DeviceTag);

	    #FlowControllerNamurBlue(SIG := #Data.Alarms.FlowControllerAlarms.NamurMaintenance,
	                  SD_1 := #DeviceTag);

	    #FlowControllerNamurOrange(SIG := #Data.Alarms.FlowControllerAlarms.NamurFunctionCheck,
	                    SD_1 := #DeviceTag);

	    #FlowControllerCommFault(SIG := #Data.Alarms.FlowControllerAlarms.CommFault,
	                  SD_1 := #DeviceTag);

	    #GasPressureLow(SIG := #Data.Alarms.PressureLow,
	                   SD_1 := #DeviceTag,
	                   SD_2 := #Data.Pressure.ActVal);

	    #GasPressureHigh(SIG := #Data.Alarms.PressureHigh,
	                    SD_1 := #DeviceTag,
	                    SD_2 := #Data.Pressure.ActVal);

	    #GasSaturationLow(SIG := #Data.Alarms.SaturationLow,
	                     SD_1 := #DeviceTag,
	                     SD_2 := #Data.PID.STATUS.PV);

	    #GasSaturationHigh(SIG := #Data.Alarms.SaturationHigh,
	                      SD_1 := #DeviceTag,
	                      SD_2 := #Data.PID.STATUS.PV);

	    #GasCalibrationOverdue(SIG := #Data.Alarms.CalibrationOverdue,
	                          SD_1 := #DeviceTag);

	    #GasPumpFeedbackError(SIG := #Data.Alarms.PumpFeedbackFault,
	                         SD_1 := #DeviceTag);

	    #GasPumpTrip(SIG := #Data.Alarms.PumpTrip,
	                SD_1 := #DeviceTag);

	    #_ProcessSensorAlarms(DeviceTag := #DeviceTag,
	                      STATUS := #Data.SensorNetwork.Data.STATUS);


END_FUNCTION_BLOCK

FUNCTION_BLOCK "ProcessUnitAlarms"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
































   VAR_INPUT
      ProcessUnit_CommLoss : Bool;
   END_VAR

   VAR_IN_OUT
      ProcessUnitData : "ProcessUnit_Data";
   END_VAR

   VAR
      ProcessUnit_ConnectionLost {InstructionName := 'Program_Alarm'; LibVersion := '1.0'} : Program_Alarm;
      GasAlarms_ProcessUnit : "GasAlarms";
      Drive_Alarms_ProcessUnit : "Drive_Alarms";
      HMI_Alarms : "HMI_Alarms";
   END_VAR


BEGIN


	    #ProcessUnit_ConnectionLost(SIG := #ProcessUnit_CommLoss,
	                           SD_1 := #ProcessUnitData.CONFIG.Name);

	    IF NOT #ProcessUnit_CommLoss THEN

	        #HMI_Alarms(Name := #ProcessUnitData.CONFIG.Name,
	                    Disconnected := NOT #ProcessUnitData.HMI_Connection);

	        #GasAlarms_ProcessUnit(DeviceTag := #ProcessUnitData.CONFIG.Name,
	                          Data := #ProcessUnitData.Gas);

	        #Drive_Alarms_ProcessUnit(DeviceTag := #ProcessUnitData.CONFIG.Name,
	                             AlarmData := #ProcessUnitData.Drive.Alarms);
	    END_IF;


END_FUNCTION_BLOCK

